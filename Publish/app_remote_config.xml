  <!-- =========================================================================
       ДОПОЛНИТЕЛЬНЫЕ БЛОКИ — заготовки на будущее.
       Не обязательно реализовывать все сразу на клиенте, но структуру
       стоит зарезервировать сейчас, чтобы не переделывать формат конфига позже.
       ========================================================================= -->

  <!-- Фича-флаги — включение/выключение функций приложения без релиза.
       СЕМАНТИКА (единая для всех флагов): флаг НЕ задан в конфиге = функция
       ВКЛЮЧЕНА по умолчанию (отсутствие флага не отключает ничего случайно);
       флаг задан и enabled="false" = функция выключена; enabled="true" = включена.

       Рекламные рубильники (проверяются в ConfigService / NetworkAdRouter):
         AD     — «вся реклама»: главный рубильник. enabled="false" — реклама
                   выключена ПОЛНОСТЬЮ (все форматы: rewarded, interstitial,
                   banner, app open — и сети, и свои кампании).
         AutoAD — «автоматическая реклама»: enabled="false" — сетевая реклама
                   (AdNetworkKillSwitch) не показывается, СВОИ кампании
                   (AdCampaigns) остаются работать.
         Btn5   — «кнопка +5»: enabled="false" — rewarded недоступен полностью,
                   кнопка «+5 монет» скрыта на всех страницах.
  -->
  <FeatureFlags>
    <!-- автоматическая реклама (сеть) -->
    <Flag name="AutoAD" enabled="true" />
	<!-- вся реклама -->
    <Flag name="AD" enabled="true" />
	<!-- кнопка +5 -->
    <Flag name="Btn5" enabled="true" />

  </FeatureFlags>

  <!-- =========================================================================
       БЛОК 4.5. Тестовые устройства (AdsTestDevices)

       Список GUID устройств для ТЕСТИРОВАНИЯ рекламы. Используется в двух местах:

       1) КАСТОМНЫЕ КРЕАТИВЫ (AdCampaign → Assets): если список НЕ пуст — свои
          картинки (BannerUrl/InterstitialUrl/RewardedUrl) показываются ТОЛЬКО
          перечисленным устройствам (тестерам); остальные получают обычную
          SDK-рекламу (проверка IsCustomCreativeAllowed в NetworkAdRouter).

       2) ТЕСТОВЫЕ КАМПАНИИ (атрибут testOnly="true" на AdCampaign): кампания
          показывается ТОЛЬКО перечисленным здесь устройствам, остальным — не
          показывается вовсе (проверка AdTestCampaignGuard в ConfigService).
          Так конкретную акцию можно обкатать на одном устройстве до массового
          запуска: пометил кампанию testOnly="true" → проверил на тестере →
          убрал атрибут → кампания пошла всем.

       ВАЖНО: пустой список / отсутствие блока = тестовых устройств нет.
       Креативы тогда показываются всем (ограничение №1 не действует),
       а тестовые кампании (testOnly="true") — НИКОМУ (безопасное поведение:
       акция не должна случайно «уйти в массы» без заполненного списка тестеров).
       ========================================================================= -->
  <AdsTestDevices>
    <DeviceId></DeviceId>
  </AdsTestDevices>

