  <!-- =========================================================================
       БЛОК 1.5. Лимиты кэша кастомных креативов (AdCampaign → Assets)
       Меняются БЕЗ релиза: правка атрибутов здесь (и на сервере) применяется
       после перезагрузки конфига.

         maxBytes   — максимальный суммарный объём кэша картинок, байт
                      (по умолчанию 50 МБ = 52428800);
         maxFiles   — максимальное число файлов в кэше (по умолчанию 200);
         maxAgeDays — сколько дней хранить креатив без использования: файлы
                      старше удаляются при выходе из приложения (и при старте),
                      чтобы кэш не занимал место на устройстве навсегда
                      (по умолчанию 30).

       При превышении maxBytes/maxFiles удаляются САМЫЕ СТАРЫЕ по дате
       последнего использования файлы. Блок отсутствует (или атрибут пуст) =
       используются дефолты из кода.
       ========================================================================= -->
  <AdCacheLimit maxBytes="52428800" maxFiles="50" maxAgeDays="3" />


  <!-- =========================================================================
       БЛОК 2. Текстовые сообщения / уведомления
       Таргетинг задаётся через <Targeting logic="AND|OR">, внутри которого
       может быть любая комбинация <SegmentRef id="..."/> (ссылка на готовый
       сегмент из блока Segments выше) и <Condition .../> (разовое условие
       прямо здесь, если заводить отдельный Segment ради одного использования
       не имеет смысла). Все элементы внутри Targeting объединяются одним
       и тем же logic — вложенных AND-внутри-OR тут намеренно нет, чтобы
       не усложнять — для сложных случаев проще завести под это отдельный Segment.

       ТЕКСТ под язык пользователя задаётся вариантами <Text lang="...">:
         lang="en,ru" — список языков через запятую (этим языкам — этот текст);
         lang="kk" — отдельный текст для одного языка;
         lang="" (или без атрибута lang) — «для всех остальных» (запасной вариант).
       Выбор варианта: точное совпадение культуры → двухбуквенный код →
       «для всех остальных» → первый в порядке файла.

       Поле Store в условиях/сегментах разделяет сообщения по магазинам, из
       которых установлено приложение (GooglePlay / RuStore / AppGallery —
       значение задаётся в AppConfig.Store).
       displayType: Popup | Banner | Toast.
       showOnce="true" — показать один раз за всё время (ключ: Id + версия
       приложения; в новой версии может показаться снова).
       showOnce="false" — показывать повторно. Своя периодичность повтора
       задаётся атрибутом repeatIntervalMinutes="N": не чаще раза в N минут
       с последнего показа ЭТОГО сообщения. Без атрибута (0) — без ограничения
       повтора (действует только общий интервал MessageLimits ниже).
       <Action type="Update" /> — кнопка «Обновить» в попапе, открывает ссылку
       магазина из ForceUpdate.StoreLinks под текущий магазин (AppConfig.Store);
       <Action type="OpenLink" url="..." /> — открывает произвольную ссылку.
	   
	   showOnce — это флаг «показать сообщение только один раз»
       ========================================================================= -->
  <Messages>

    <!-- Просто ссылка на готовый сегмент -->
    <Message id="msg-please-update" enabled="false" priority="10" displayType="Popup" showOnce="true">
      <Text lang="en,ru">Пожалуйста, обновите приложение до последней версии</Text>
      <Text lang="kk">Қосымшаны соңғы нұсқаға жаңартыңыз</Text>
      <Text lang="">Please update the app to the latest version</Text>
      <!-- Кнопка «Обновить»: открывает ссылку магазина (ForceUpdate.StoreLinks
           под AppConfig.Store) — Play/RuStore/AppGallery страницу приложения -->
      <Action type="Update" />
      <Targeting logic="AND">
        <SegmentRef id="seg-app-version-old" />
      </Targeting>
    </Message>

    <!-- Составной сегмент целиком описан один раз в Segments и переиспользуется -->
    <Message id="msg-male-promo" enabled="false" priority="5" displayType="Banner" showOnce="false" repeatIntervalMinutes="60">
      <Text lang="ru">Специальное предложение для тебя</Text>
      <Text lang="">Special offer for you</Text>
      <Targeting logic="AND">
        <SegmentRef id="seg-male-ru" />
      </Targeting>
    </Message>

    <!-- Комбинация двух независимых сегментов прямо в Targeting (Toast - снизу появляется некое сообщение и само исчезает)-->
    <Message id="msg-non-ru-classic11" enabled="false" priority="1" displayType="Toast" showOnce="true">
      <Text lang="">Try the classic theme 1</Text>
      <Targeting logic="AND">
        <SegmentRef id="seg-non-ru-lang" />
        <SegmentRef id="seg-classic-theme" />
      </Targeting>
    </Message>

    <!-- Комбинация двух независимых сегментов прямо в Targeting ( Banner сверху сообщение с кнопкой закрыть)-->
    <Message id="msg-non-ru-classic22" enabled="false" priority="2" displayType="Banner" showOnce="true">
      <Text lang="">Try the classic theme 2 </Text>
      <Targeting logic="AND">
        <SegmentRef id="seg-non-ru-lang" />
        <SegmentRef id="seg-classic-theme" />
      </Targeting>
    </Message>
	
	<!-- Комбинация двух независимых сегментов прямо в Targeting (Popup - окно с кнопкой закрыть) -->
    <Message id="msg-non-ru-classic31" enabled="false" priority="3" displayType="Popup" showOnce="true">
      <Text lang="">Try the classic theme 3</Text>
      <Targeting logic="AND">
        <SegmentRef id="seg-non-ru-lang" />
        <SegmentRef id="seg-classic-theme" />
      </Targeting>
    </Message>
	
	
    <!-- Пример смешивания сегмента с разовым локальным условием,
         которое заводить отдельным Segment пока не имеет смысла -->
    <Message id="msg-rustore-old-version" enabled="false" priority="8" displayType="Popup" showOnce="true">
      <Text lang="ru">Обновите приложение из RuStore, чтобы реклама продолжала работать</Text>
      <Text lang="">Update the app from RuStore to keep ads working</Text>
      <Targeting logic="AND">
        <SegmentRef id="seg-rustore-users" />
        <Condition field="AppVersion" operator="LessOrEqual" value="4" />
      </Targeting>
    </Message>

  </Messages>

  <!-- =========================================================================
       БЛОК 2.5. Общие лимиты показа текстовых сообщений (MessageLimits)

       minIntervalMinutes — минимальный интервал между показами ЛЮБЫХ текстовых
       сообщений (блок Messages), минуты. 0 = без ограничения (пачка сообщений
       показывается подряд). Блок отсутствует / атрибут не задан = дефолт из
       кода (30 минут). Индивидуальная периодичность конкретного сообщения
       задаётся на самом сообщении (repeatIntervalMinutes при showOnce="false").

       maxPerDay — максимум показанных текстовых сообщений в сутки.
       0 = без ограничения. Блок отсутствует / атрибут не задан = дефолт
       из кода (3).
       ========================================================================= -->
  <MessageLimits minIntervalMinutes="0" maxPerDay="30" />


